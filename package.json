{
	"name": "@redeemid/emdash",
	"version": "0.0.1",
	"description": "Shopify customer accounts, member levels and paywalls for EmDash sites. Shopify runs commerce; EmDash runs content.",
	"type": "module",
	"license": "GPL-2.0-or-later",
	"author": "Vinny S. Green, LLC",
	"homepage": "https://www.redeemid.com/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/webmultipliers/redeemid-emdash.git"
	},
	"exports": {
		".": "./src/index.ts",
		"./access": "./src/access.ts",
		"./guard.ts": "./src/guard.ts",
		"./components/*": "./src/components/*",
		"./routes/*": "./src/routes/*"
	},
	"files": [
		"src"
	],
	"keywords": [
		"emdash",
		"shopify",
		"paywall",
