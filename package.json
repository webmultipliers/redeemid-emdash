		"@emdash-cms/auth": ">=1.4.0",
		"astro": ">=6",
		"emdash": ">=1.4.0"
	},
	"dependencies": {
		"jose": "^6.1.3"
	},
	"devDependencies": {
		"@emdash-cms/auth": "^1.4.0",
		"astro": "^7.3.2",
		"emdash": "^1.4.0",
		"kysely": "^0.29.0",
		"typescript": "^6.0.3",
		"vitest": "4.1.10"
	},
	"packageManager": "pnpm@10.28.0"
