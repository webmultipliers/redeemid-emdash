---
/**
 * Show the default slot to readers who may read the entry, the "locked" slot
 * (or a built-in notice) to everyone else.
 *
 *   <Gate collection="posts" terms={post.data.terms}>
 *     <PortableText value={post.data.content} />
 *     <p slot="locked">…teaser…</p>
 *   </Gate>
 *
 * Pass `levels` to lock a part of a page to specific levels instead.
 */
import { canRead, type Terms } from "../access.js";
import LockedPanel from "./LockedPanel.astro";

interface Props {
	collection?: string;
	terms?: Terms;
	levels?: string[];
}

const { collection = "", terms, levels } = Astro.props;
const verdict = await canRead(Astro, { collection, terms }, levels ? { levels } : undefined);
---

{verdict.allowed ? (
	<slot />
) : (
	<LockedPanel reason={verdict.reason} required={verdict.required} held={verdict.viewer.levels}>
		<slot name="locked" />
	</LockedPanel>
)}
