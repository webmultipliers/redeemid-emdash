---
/**
 * The member's own account card, for an account page: their levels with
 * when each started, when the membership renews or ends and any gift
 * membership (from the shop's membership.* customer metafields), levels
 * they held before, the meter, and links to the
 * store account, Refresh membership and Sign out. Visitors get a sign-in link.
 *
 *   <MemberCard />
 *
 * Everything shown comes from the mirrored Shopify customer; Refresh
 * membership reads it from the store again.
 */
import { accountUrl, badgeColor, membership, meterUsage, refreshUrl, signInUrl, signOutUrl, viewer } from "../access.js";
import { featuresFor } from "../features.js";
import { siteConfig } from "../site-config.js";
import { text, textParts } from "../text.js";

interface Props {
	/** Heading text; the member's first name is added after it. */
	title?: string;
}

const config = await siteConfig(Astro.locals);
const { title = text(config, "Your membership") } = Astro.props;
const v = await viewer(Astro);
const here = Astro.url.pathname + Astro.url.search;
const m = v.member;
const disabled = m?.status === "disabled";
const { current, past } = m && !disabled ? membership(m, config?.levels) : { current: [], past: [] };
const meter = v.signedIn ? await meterUsage(Astro) : null;
const color = (slug: string) => badgeColor(config?.levels?.find((l) => l.slug === slug));
const held = m ? featuresFor(m, config?.features, config?.levels) : [];
const features = (config?.features ?? []).filter((f) => held.includes(f.slug));
const date = (iso: string | null) => {
	if (!iso) return null;
	const t = Date.parse(iso);
	return Number.isNaN(t) ? null : new Intl.DateTimeFormat("en-US", { dateStyle: "long", timeZone: "UTC" }).format(new Date(t));
};
const name = [m?.firstName, m?.lastName].filter(Boolean).join(" ");
// Dates the shop keeps in Shopify (Flow or a subscription app). Display only.
const dates = m && !disabled ? (m.dates ?? {}) : {};
const today = new Date().toISOString().slice(0, 10);
const gift = dates.gift && dates.gift >= today ? dates.gift : null;
const day = (ymd: string | null | undefined) => (ymd ? date(`${ymd}T12:00:00Z`) : null);
const join = config?.join;
---

<section class="redeemid-member" data-redeemid-signed-in={v.signedIn ? "true" : "false"}>
	{v.signedIn ? (
		<>
			<h2 class="redeemid-member__title">{title}</h2>
			{(name || m?.email) && (
				<p class="redeemid-member__who">
					{name && <strong>{name}</strong>}
					{m?.email && <span>{m.email}</span>}
				</p>
			)}
			{disabled ? (
				<p class="redeemid-member__disabled">{text(config, "Your account is turned off. Contact the store for help.")}</p>
			) : current.length > 0 ? (
				<ul class="redeemid-member__levels">
					{current.filter((l) => !l.via).map((l) => (
						<li data-redeemid-level={l.slug} style={color(l.slug) ? `--redeemid-level-color: ${color(l.slug)}` : undefined}>
							<strong>{l.name}</strong>
							{(dates.since ? day(dates.since) : date(l.since)) && <> {textParts(config, "since {date}", { date: <time datetime={dates.since ?? l.since ?? undefined}>{dates.since ? day(dates.since) : date(l.since)}</time> })}</>}
						</li>
					))}
				</ul>
			) : (
				<p class="redeemid-member__none">
					{text(config, "You don't have a membership yet.")}{join && <> <a href={join.href}>{join.label ?? text(config, "Become a member")}</a></>}
				</p>
			)}
			{current.length > 0 && (dates.renews || dates.ends || gift) && (
				<ul class="redeemid-member__dates">
					{dates.renews && <li data-redeemid-date="renews">{textParts(config, "Renews on {date}", { date: <time datetime={dates.renews}>{day(dates.renews)}</time> })}</li>}
					{dates.ends && <li data-redeemid-date="ends">{textParts(config, "Ends on {date}", { date: <time datetime={dates.ends}>{day(dates.ends)}</time> })}</li>}
					{gift && <li data-redeemid-date="gift">{textParts(config, "Gift membership until {date}", { date: <time datetime={gift}>{day(gift)}</time> })}</li>}
				</ul>
			)}
			{features.length > 0 && (
				<p class="redeemid-member__features">
					{text(config, "Includes: {features}", { features: features.map((f) => f.name).join(", ") })}
				</p>
			)}
			{past.length > 0 && (
				<>
					<h3 class="redeemid-member__subtitle">{text(config, "Before")}</h3>
					<ul class="redeemid-member__past">
						{past.map((l) => (
							<li data-redeemid-level={l.slug}>
								{l.name}
								{", "}{date(l.from) ? text(config, "{from} to {to}", { from: date(l.from) ?? "", to: date(l.to) ?? "" }) : text(config, "until {to}", { to: date(l.to) ?? "" })}
							</li>
						))}
					</ul>
				</>
			)}
			{meter && current.length === 0 && !disabled && (
				<p class="redeemid-member__meter" data-redeemid-used={meter.used}>
					{text(config, meter.period === "week" ? "Free reads this week: {used} of {limit} used." : "Free reads this month: {used} of {limit} used.", { used: meter.used, limit: meter.limit })}
				</p>
			)}
			<p class="redeemid-member__actions">
				<a href={accountUrl(here)}>{text(config, "Orders and details")}</a>
				<a href={refreshUrl(here)}>{text(config, "Refresh membership")}</a>
			</p>
			<form method="post" action={signOutUrl("/")}>
				<button type="submit">{text(config, "Sign out")}</button>
			</form>
			<p class="redeemid-member__note">{text(config, "Just bought a plan? It can take a minute to show here. Refresh membership checks again.")}</p>
		</>
	) : (
		<p>
			{textParts(config, "{signIn} to see your membership.", { signIn: <a href={signInUrl(here)}>{config?.label ?? text(config, "Sign in")}</a> })}
		</p>
	)}
</section>
