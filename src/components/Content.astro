---
/**
 * An entry's body, with RedeemID's blocks applied.
 *
 *   <Content value={post.data.content} collection="posts" terms={post.data.terms} id={post.id} />
 *
 * - "Paywall break": everything before the first one is shown to everyone.
 *   What follows reaches the page only for readers who may read it: the
 *   levels picked on the break, or when none are picked the entry's rule
 *   (with no rule, the break changes nothing).
 * - "Members only" … "Members only: end": the part between is for the levels
 *   picked on the start block, or the entry's rule, or any signed-in member.
 *   Readers who can't read it see the wall in its place, and the body goes on.
 * - No break: the entry's rule covers the whole body; readers it keeps out see
 *   the collection's teaser (config `teaser`, in words), if any.
 *
 * - "Sold on its own": readers holding the block's Shopify tag read the whole
 *   entry, whatever its rule, breaks and drip say. Others see "Buy just this"
 *   on the wall when the block names a product.
 *
 * Readers kept out get the wall (LockedPanel), with the "locked" slot on top.
 *
 * Pass `id` on the entry's own page so drip and the meter apply: a rule's
 * `drip` keeps it shut until the member has held their level that many days,
 * and config `meter` lets signed-in readers open a few locked entries each
 * period (each entry counts once). Leave `id` off in lists.
 *
 * With `id`, a locked entry's page also gets Google's paywalled-content
 * markup (isAccessibleForFree false, pointing at the wall), the same for
 * every reader. Pass `title` for its headline. Config `schema: false` turns
 * it off.
 */
import { PortableText } from "emdash/ui";

import { canRead, entryRequirement, readEntry, viewer, type Terms, type Verdict } from "../access.js";
import { holdsItem, sections, soldItem, splitAtPaywall, teaser } from "../blocks-names.js";
import { siteConfig } from "../site-config.js";
import { text } from "../text.js";
import LockedPanel from "./LockedPanel.astro";

interface Props {
	value?: unknown[] | null;
	collection?: string;
	terms?: Terms;
	/** The entry's id, on its own page: turns on drip, the meter and the paywall markup. */
	id?: string;
	/** The entry's title, for the paywall markup's headline. */
	title?: string;
}

const { value, collection = "", terms, id, title } = Astro.props;
const split = splitAtPaywall(value);
const config = siteConfig((Astro.locals as { emdash?: { config?: unknown } }).emdash?.config);
const entryRule = await entryRequirement(config, collection, terms);
// Bought on its own: the whole entry, no meter, no drip.
const item = soldItem(value);
const reader = item ? (await viewer(Astro)).member : null;
const owned = Boolean(reader && reader.status !== "disabled" && holdsItem(item, reader.tags));
// A break with levels picked locks the rest to them; with none picked it
// follows the entry's rule, and does nothing when no rule covers the entry.
const required = split.paywall ? (split.levels.length ? [split.levels] : entryRule) : undefined;
const verdict: Verdict | { allowed: true; reason: "open" } =
	owned || (split.paywall && required === null)
		? { allowed: true, reason: "open" }
		: id
			? await readEntry(Astro, { collection, terms, id }, required ? { required } : undefined)
			: await canRead(Astro, { collection, terms }, required ? { required } : undefined);
const words = config?.teaser?.[collection] ?? 0;
const shown = split.paywall ? split.open : verdict.allowed ? split.open : teaser(split.open, words);
const rest = verdict.allowed ? split.locked : [];

// Each "Members only" part gets its own verdict.
async function parts(blocks: unknown[]) {
	const out: Array<{ blocks: unknown[]; verdict?: Verdict }> = [];
	for (const section of sections(blocks)) {
		if (!section.members || owned) {
			out.push({ blocks: section.blocks });
			continue;
		}
		const needs = section.levels.length ? [section.levels] : (entryRule ?? [[]]);
		out.push({ blocks: section.blocks, verdict: await canRead(Astro, { collection, terms }, { required: needs }) });
	}
	return out;
}
const before = await parts(shown);
const after = await parts(rest);
// Google's paywalled-content markup, on the entry's own page when any of it is locked.
const lockedEntry = Boolean(split.paywall ? required : entryRule) || sections(value ?? []).some((s) => s.members);
const schema =
	id && lockedEntry && config?.schema !== false
		? JSON.stringify({
				"@context": "https://schema.org",
				"@type": "Article",
				...(title ? { headline: title } : {}),
				url: Astro.url.origin + Astro.url.pathname,
				isAccessibleForFree: false,
				hasPart: { "@type": "WebPageElement", isAccessibleForFree: false, cssSelector: ".redeemid-locked" },
			}).replace(/</g, "\\u003c")
		: null;
const metered = verdict.reason === "metered" ? (verdict as Verdict) : null;
const week = metered?.meter?.period === "week";
const left = metered?.meterLeft ?? 0;
const meterText =
	left === 0
		? text(config, week ? "This is your last free read this week." : "This is your last free read this month.")
		: left === 1
			? text(config, week ? "You have 1 free read left this week." : "You have 1 free read left this month.")
			: text(config, week ? "You have {count} free reads left this week." : "You have {count} free reads left this month.", { count: left });
---

{schema && <script type="application/ld+json" set:html={schema} />}
{metered && (
	<p class="redeemid-meter" role="status" data-redeemid-left={metered.meterLeft}>
		{meterText}
	</p>
)}
{before.map((p) =>
	!p.verdict || p.verdict.allowed ? (
		p.blocks.length > 0 && <PortableText value={p.blocks} />
	) : (
		<LockedPanel reason={p.verdict.reason} required={p.verdict.required} held={p.verdict.viewer.levels} item={item} />
	),
)}
{verdict.allowed ? (
	after.map((p) =>
		!p.verdict || p.verdict.allowed ? (
			p.blocks.length > 0 && <PortableText value={p.blocks} />
		) : (
			<LockedPanel reason={p.verdict.reason} required={p.verdict.required} held={p.verdict.viewer.levels} item={item} />
		),
	)
) : (
	<LockedPanel
		reason={verdict.reason}
		required={verdict.required}
		held={verdict.viewer.levels}
		opensAt={verdict.opensAt}
		meterLeft={verdict.meterLeft}
		meterPeriod={verdict.meter?.period}
		item={item}
	>
		<slot name="locked" />
	</LockedPanel>
)}
