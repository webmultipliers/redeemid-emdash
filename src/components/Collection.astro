---
/**
 * A Shopify collection as a grid of product cards: image, title, lowest
 * price. Each card links to `productHref` with `{handle}` filled in, so the
 * site can give every product its own page with <Product>.
 *
 *   <Collection handle="shop" productHref="/shop/{handle}/" />
 */
import { siteConfig } from "../site-config.js";
import { collection as loadCollection, money, type Collection } from "../storefront.js";

interface Props {
	handle: string;
	/** How many products, 1 to 50. */
	limit?: number;
	/** Link for each product; `{handle}` is replaced. Leave out for cards without links. */
	productHref?: string;
	/** Show the collection's title and description above the grid. */
	showTitle?: boolean;
}

const { handle, limit = 12, productHref, showTitle = false } = Astro.props;
const config = siteConfig((Astro.locals as { emdash?: { config?: unknown } }).emdash?.config);
let c: Collection | null = null;
if (config) {
	try {
		c = await loadCollection(config, handle, limit);
	} catch {
		c = null;
	}
}
const href = (h: string) => productHref?.replaceAll("{handle}", encodeURIComponent(h));
---

{c && c.products.length > 0 ? (
	<section class="redeemid-collection" data-redeemid-collection={c.handle}>
		{showTitle && (
			<>
				<h2 class="redeemid-collection__title">{c.title}</h2>
				{c.description && <p class="redeemid-collection__description">{c.description}</p>}
			</>
		)}
		<ul class="redeemid-collection__grid">
			{c.products.map((p) => (
				<li class="redeemid-collection__item" data-redeemid-product={p.handle}>
					{p.image && <img src={p.image.url} alt={p.image.altText ?? ""} loading="lazy" />}
					<h3>{href(p.handle) ? <a href={href(p.handle)}>{p.title}</a> : p.title}</h3>
					<p class="redeemid-collection__price">{p.availableForSale ? (p.price ? `From ${money(p.price)}` : "") : "Sold out"}</p>
				</li>
			))}
		</ul>
	</section>
) : (
	<slot />
)}
