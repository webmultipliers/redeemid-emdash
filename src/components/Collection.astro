---
/**
 * A Shopify collection as a grid of product cards: image, title, lowest
 * price. Each card links to `productHref` with `{handle}` filled in, so the
 * site can give every product its own page with <Product>.
 *
 *   <Collection handle="shop" productHref="/shop/{handle}/" />
 *   <Collection handle="shop" productHref="/shop/{handle}/" browse />
 *
 * `browse` adds Shopify's filters, sort orders and paging, read from the
 * page URL (so the page must be rendered on demand). `quickAdd` adds Add to
 * cart on cards that need no choice.
 */
import { browseFromUrl, collectionPage, type CollectionPage } from "../catalog.js";
import { siteConfig } from "../site-config.js";
import { collection as loadCollection, storeContext, type Collection } from "../storefront.js";
import BrowseControls from "./BrowseControls.astro";
import ProductGrid from "./ProductGrid.astro";

interface Props {
	handle: string;
	/** How many products (per page with `browse`), 1 to 50. */
	limit?: number;
	/** Link for each product; `{handle}` is replaced. Leave out for cards without links. */
	productHref?: string;
	/** Show the collection's title and description above the grid. */
	showTitle?: boolean;
	/** Filters, sorting and paging from the page URL. */
	browse?: boolean;
	quickAdd?: boolean;
}

const { handle, limit = 12, productHref, showTitle = false, browse = false, quickAdd = false } = Astro.props;
const config = await siteConfig(Astro.locals);
const context = storeContext(config, Astro.request);
let c: Collection | CollectionPage | null = null;
if (config) {
	try {
		c = browse ? await collectionPage(config, handle, browseFromUrl(Astro.url.searchParams, limit), { context }) : await loadCollection(config, handle, limit, undefined, context);
	} catch {
		c = null;
	}
}
const page = c && "pageInfo" in c ? c : null;
const id = `redeemid-collection-${handle}`;
---

{c && (c.products.length > 0 || page) ? (
	<section class="redeemid-collection" data-redeemid-collection={c.handle}>
		{showTitle && (
			<>
				<h2 class="redeemid-collection__title">{c.title}</h2>
				{c.description && <p class="redeemid-collection__description">{c.description}</p>}
			</>
		)}
		{page && <BrowseControls filters={page.filters} pageInfo={page.pageInfo} id={id} />}
		<ProductGrid products={c.products} productHref={productHref} quickAdd={quickAdd} />
	</section>
) : (
	<slot />
)}
