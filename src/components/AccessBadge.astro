---
/**
 * The level an entry needs, read from its rules (and from a paywall break
 * with levels):
 *
 *   <AccessBadge collection="posts" terms={post.data.terms} content={post.data.content} />
 *
 * Open entries show `free` ("Free"; pass free="" to show nothing). The badge
 * carries `data-redeemid-level` (the level slugs) for styling, and
 * `is-locked` with a lock for readers who can't read the members part.
 */
import { canRead, describe, entryRequirement, viewer, type Terms } from "../access.js";
import { holdsItem, soldItem, splitAtPaywall } from "../blocks-names.js";
import { siteConfig } from "../site-config.js";
import { text } from "../text.js";

interface Props {
	collection: string;
	terms?: Terms;
	/** The entry's body, so a paywall break's levels count. */
	content?: unknown[] | null;
	free?: string;
	class?: string;
}

const config = siteConfig((Astro.locals as { emdash?: { config?: unknown } }).emdash?.config);
const { collection, terms, content, free = text(config, "Free"), class: className } = Astro.props;
const split = splitAtPaywall(content);
const required = split.paywall && split.levels.length
	? [split.levels]
	: await entryRequirement(config, collection, terms);
const label = describe(required, config?.levels, free, text(config, "Signed in"));
const item = soldItem(content);
const owner = item ? (await viewer(Astro)).member : null;
const owned = Boolean(owner && owner.status !== "disabled" && holdsItem(item, owner.tags));
const locked = required !== null && !owned && !(await canRead(Astro, { collection, terms }, { required })).allowed;
const slugs = required?.flat().join(" ") || (required ? "signed-in" : "free");
---

{label && (
	<span
		class:list={["redeemid-badge", { "is-locked": locked }, className]}
		data-redeemid-level={slugs}
	>
		{locked && <span class="redeemid-badge__lock" aria-hidden="true">🔒&#xFE0E; </span>}
		{label}
		{locked && <span style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap">{text(config, " (locked)")}</span>}
	</span>
)}
