---
/**
 * The level an entry needs, read from its rules:
 *
 *   <AccessBadge collection="posts" terms={post.data.terms} content={post.data.content} id={post.id} />
 *
 * Open entries show `free` ("Free"; pass free="" to show nothing). The badge
 * carries `data-redeemid-level` (the level slugs) for styling, and
 * `is-locked` with a lock for readers who can't read the members part.
 */
import { badgeColor, canRead, describe, entryRequirement, simplify, viewer, type Terms } from "../access.js";
import { holdsItem, soldItem } from "../blocks-names.js";
import { siteConfig } from "../site-config.js";
import { text } from "../text.js";

interface Props {
	collection: string;
	terms?: Terms;
	/** The entry's body, for its "Sold on its own" block. */
	content?: unknown[] | null;
	/** The entry's id or slug, so its own rule from the editor counts. */
	id?: string;
	free?: string;
	class?: string;
}

const config = await siteConfig(Astro.locals);
const { collection, terms, content, id, free = text(config, "Free"), class: className } = Astro.props;
const required = await entryRequirement(config, collection, terms, id);
const label = describe(required, config?.levels, free, text(config, "Signed in"));
const item = soldItem(content);
const owner = item ? (await viewer(Astro)).member : null;
const owned = Boolean(owner && owner.status !== "disabled" && holdsItem(item, owner.tags));
const locked = required !== null && !owned && !(await canRead(Astro, { collection, terms, id }, { required })).allowed;
const slugs = required?.flat().join(" ") || (required ? "signed-in" : "free");
// The colour of the level the badge names first, when that level has one.
const color = badgeColor(config?.levels?.find((l) => l.slug === simplify(required, config?.levels)?.find((c) => c.length)?.[0]));
---

{label && (
	<span
		class:list={["redeemid-badge", { "is-locked": locked }, className]}
		data-redeemid-level={slugs}
		style={color ? `--redeemid-level-color: ${color}` : undefined}
	>
		{locked && <span class="redeemid-badge__lock" aria-hidden="true">🔒&#xFE0E; </span>}
		{label}
		{locked && <span style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap">{text(config, " (locked)")}</span>}
	</span>
)}
