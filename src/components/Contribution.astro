---
/**
 * Pay what you want: the reader picks an amount and checks out. Set up a
 * Shopify product priced at 1.00 (one unit of the currency); the amount
 * becomes the line's quantity, so Shopify charges exactly what they chose.
 * With another price the field asks for a quantity instead.
 *
 *   <Contribution handle="support-the-newsroom" amounts={[5, 10, 25]} />
 */
import { siteConfig } from "../site-config.js";
import { money, product as loadProduct, type Product } from "../storefront.js";
import { text } from "../text.js";

interface Props {
	handle: string;
	/** Suggested amounts, as buttons. */
	amounts?: number[];
	/** The amount filled in to start with. */
	initial?: number;
	label?: string;
	title?: string;
}

const config = siteConfig((Astro.locals as { emdash?: { config?: unknown } }).emdash?.config);
const { handle, amounts = [5, 10, 25], initial = 10, label = text(config, "Give"), title } = Astro.props;
let p: Product | null = null;
if (config) {
	try {
		p = await loadProduct(config, handle);
	} catch {
		p = null;
	}
}
const variant = p?.variants.find((v) => v.availableForSale);
const unit = variant ? Number(variant.price.amount) === 1 : false;
const currency = variant?.price.currencyCode ?? "USD";
const symbol = new Intl.NumberFormat("en-US", { style: "currency", currency }).formatToParts(0).find((x) => x.type === "currency")?.value ?? "";
const here = Astro.url.pathname + Astro.url.search;
const id = `redeemid-give-${handle}`;
---

{p && variant ? (
	<form class="redeemid-contribution" method="post" action="/_emdash/api/auth/redeemid/cart-edit" data-redeemid-product={p.handle}>
		<h2 class="redeemid-contribution__title">{title ?? p.title}</h2>
		{p.description && <p>{p.description}</p>}
		<input type="hidden" name="action" value="add" />
		<input type="hidden" name="product" value={p.handle} />
		<input type="hidden" name="variant" value={variant.id} />
		<input type="hidden" name="return" value={here} />
		<input type="hidden" name="then" value="checkout" />
		{unit ? (
			<>
				{amounts.length > 0 && (
					<p class="redeemid-contribution__amounts">
						{amounts.map((a) => (
							<button type="submit" name="quantity" value={String(a)}>{symbol}{a}</button>
						))}
					</p>
				)}
				<p>
					<label for={`${id}-amount`}>{text(config, "Another amount ({currency})", { currency })}</label>
					<input id={`${id}-amount`} name="quantity" type="number" min="1" max="1000" step="1" value={initial} inputmode="numeric" />
				</p>
			</>
		) : (
			<p>
				<label for={`${id}-amount`}>{text(config, "Quantity ({price} each)", { price: money(variant.price) })}</label>
				<input id={`${id}-amount`} name="quantity" type="number" min="1" max="1000" value="1" inputmode="numeric" />
			</p>
		)}
		<button type="submit">{label}</button>
	</form>
) : (
	<slot />
)}
