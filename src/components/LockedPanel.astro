---
/**
 * The wall readers see in place of what they can't read: why, and what to do
 * next (sign in, or join). <Content> and <Gate> show it; use it directly for
 * your own locked parts.
 *
 * The level it offers is the first one the reader is missing. Its `wall` text
 * and `joinUrl` come from the level's config, the join link from `join`.
 * Anything in the default slot is shown above the built-in text.
 */
import { passes, signInUrl, type Reason } from "../access.js";
import type { SoldItem } from "../blocks-names.js";
import { plan as loadPlan } from "../storefront.js";
import { siteConfig } from "../site-config.js";
import { text, textParts } from "../text.js";

interface Props {
	reason: Reason;
	/** What the locked part needs (Verdict.required). */
	required?: string[][];
	/** Levels the reader holds (Verdict.viewer.levels). */
	held?: string[];
	/** For "drip": when it opens (Verdict.opensAt). */
	opensAt?: Date;
	/** Free reads left when a meter ran (Verdict.meterLeft); 0 shows the meter-used text. */
	meterLeft?: number;
	meterPeriod?: "month" | "week";
	/** The entry's "Sold on its own" block: offers "Buy just this". */
	item?: SoldItem | null;
	/** The entry's id or slug, for the browser client's wall_shown event. */
	entry?: string;
}

const { reason, required = [], held = [], opensAt, meterLeft, meterPeriod, item, entry } = Astro.props;
const opens = opensAt
	? new Intl.DateTimeFormat("en-US", { dateStyle: "long", timeZone: "UTC" }).format(opensAt)
	: null;
const config = await siteConfig(Astro.locals);
const missing = required.find((clause) => clause.length > 0 && !passes(held, [clause]));
const level = missing ? config?.levels?.find((l) => l.slug === missing[0]) : undefined;
const joinHref = level?.joinUrl ?? config?.join?.href;
const joinLabel = config?.join?.label ?? text(config, "Become a member");
const week = meterPeriod === "week";
// "Buy just this": the item's product and price, read from Shopify.
let single: { handle: string; price: string } | null = null;
if (item?.product && config && (reason === "sign_in" || reason === "upgrade" || reason === "drip")) {
	try {
		const p = await loadPlan(config, item.product);
		if (p?.availableForSale && p.price) {
			single = { handle: p.handle, price: new Intl.NumberFormat("en-US", { style: "currency", currency: p.price.currencyCode }).format(Number(p.price.amount)) };
		}
	} catch {
		single = null;
	}
}
const here = Astro.url.pathname + Astro.url.search;
---

<div class="redeemid-locked" data-redeemid-reason={reason} data-redeemid-level={level?.slug} data-redeemid-entry={entry}>
	<slot />
	{level?.wall && (reason === "sign_in" || reason === "upgrade") && <p class="redeemid-locked__wall">{level.wall}</p>}
	{reason === "sign_in" && (
		<p>
			{textParts(config, "This is for members. {signIn} to read on.", { signIn: <a href={signInUrl(here)}>{text(config, "Sign in")}</a> })}
			{joinHref && <> {textParts(config, "Not a member yet? {join}.", { join: <a href={joinHref}>{joinLabel}</a> })}</>}
		</p>
	)}
	{reason === "upgrade" && meterLeft === 0 && (
		<p class="redeemid-locked__meter">{text(config, week ? "You've used your free reads this week." : "You've used your free reads this month.")}</p>
	)}
	{reason === "drip" && (
		<p>
			{opens ? textParts(config, "This opens for you on {date}.", { date: <time datetime={opensAt?.toISOString()}>{opens}</time> }) : text(config, "This opens for you after you've been a member a little longer.")}
		</p>
	)}
	{reason === "upgrade" && (
		<p>
			{level ? text(config, "This is for {level} members.", { level: level.name }) : text(config, "Your membership doesn't include this yet.")}
			{joinHref && <> <a href={joinHref}>{joinLabel}</a></>}
		</p>
	)}
	{single && (
		<form class="redeemid-locked__single" method="post" action="/_emdash/api/auth/redeemid/buy" data-redeemid-item={item?.tag}>
			<input type="hidden" name="plan" value={single.handle} />
			<input type="hidden" name="return" value={here} />
			<p>{text(config, "Or buy just this for {price}.", { price: single.price })}</p>
			<button type="submit">{text(config, "Buy just this")}</button>
		</form>
	)}
	{reason === "disabled" && <p>{text(config, "Your account is turned off. Contact the store for help.")}</p>}
	{reason === "unconfigured" && <p>{text(config, "This is for members.")}</p>}
</div>
