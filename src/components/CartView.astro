---
/**
 * The visitor's Shopify cart for a cart page: each line with its price and
 * a quantity to change or remove, a discount code, the totals, and
 * Checkout. Shopify works out prices and discounts; changes go through
 * the cart-edit route and come back here with a notice.
 *
 *   <CartView />
 */
import { cartUrl } from "../access.js";
import { readCart, saveCart } from "../cart.js";
import { siteConfig } from "../site-config.js";
import { cartDetails, money, type CartDetails } from "../storefront.js";
import { text } from "../text.js";

interface Props {
	/** Link for each line's product; `{handle}` is replaced. */
	productHref?: string;
	/** Shown when the cart is empty. */
	empty?: string;
}

const config = await siteConfig(Astro.locals);
const { productHref, empty = text(config, "Your cart is empty.") } = Astro.props;
const ref = await readCart(Astro.session);
let cart: CartDetails | null = null;
let failed = false;
if (config && ref) {
	try {
		cart = await cartDetails(config, ref.id, { buyerIp: Astro.request.headers.get("cf-connecting-ip") });
		if (!cart) saveCart(Astro.session, null);
		else if (cart.totalQuantity !== ref.count) saveCart(Astro.session, { id: cart.id, count: cart.totalQuantity });
	} catch {
		failed = true;
	}
}
// A cart page is the visitor's own.
Astro.response.headers.set("Cache-Control", "private, no-store");
const here = Astro.url.pathname;
const href = (h: string) => productHref?.replaceAll("{handle}", encodeURIComponent(h));
const action = "/_emdash/api/auth/redeemid/cart-edit";
const code = cart?.discountCodes[0];
---

<section class="redeemid-cartview" data-redeemid-cart-count={cart?.totalQuantity ?? 0}>
	{failed ? (
		<p>{text(config, "Your cart isn't available right now. Try again in a few minutes.")}</p>
	) : !cart || cart.lines.length === 0 ? (
		<p class="redeemid-cartview__empty">{empty}</p>
	) : (
		<>
			<ul class="redeemid-cartview__lines">
				{cart.lines.map((l) => (
					<li class="redeemid-cartview__line" data-redeemid-line={l.id}>
						{l.image && <img src={l.image.url} alt={l.image.altText ?? ""} loading="lazy" />}
						<div class="redeemid-cartview__item">
							<p class="redeemid-cartview__name">
								{href(l.productHandle) ? <a href={href(l.productHandle)}>{l.productTitle}</a> : l.productTitle}
								{l.variantTitle && l.variantTitle !== "Default Title" && <span> · {l.variantTitle}</span>}
							</p>
							<p class="redeemid-cartview__price">{text(config, "{price} each · {total}", { price: money(l.price), total: money(l.total) })}</p>
							<form method="post" action={action} class="redeemid-cartview__quantity">
								<input type="hidden" name="action" value="update" />
								<input type="hidden" name="line" value={l.id} />
								<input type="hidden" name="return" value={here} />
								<label for={`q-${l.id}`}>{text(config, "Quantity")}</label>
								<input id={`q-${l.id}`} name="quantity" type="number" min="0" max="1000" value={l.quantity} inputmode="numeric" />
								<button type="submit">{text(config, "Update")}</button>
							</form>
							<form method="post" action={action}>
								<input type="hidden" name="action" value="remove" />
								<input type="hidden" name="line" value={l.id} />
								<input type="hidden" name="return" value={here} />
								<button type="submit" class="redeemid-cartview__remove">{text(config, "Remove")}<span style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap"> {l.productTitle}</span></button>
							</form>
						</div>
					</li>
				))}
			</ul>
			<form method="post" action={action} class="redeemid-cartview__discount">
				<input type="hidden" name="action" value="discount" />
				<input type="hidden" name="return" value={here} />
				<label for="redeemid-discount">{text(config, "Discount code")}</label>
				<input id="redeemid-discount" name="code" type="text" value={code?.code ?? ""} autocomplete="off" />
				<button type="submit">{text(config, "Apply")}</button>
				{code && !code.applicable && <p class="redeemid-cartview__code-note">{text(config, "{code} doesn't apply to this cart.", { code: code.code })}</p>}
			</form>
			<dl class="redeemid-cartview__totals">
				<dt>{text(config, "Subtotal")}</dt>
				<dd>{money(cart.subtotal)}</dd>
				<dt>{text(config, "Total")}</dt>
				<dd>{money(cart.total)}</dd>
			</dl>
			<p class="redeemid-cartview__note">{text(config, "Taxes and shipping are worked out at checkout.")}</p>
			<a class="redeemid-cartview__checkout" href={cartUrl(here)}>{text(config, "Checkout")}</a>
		</>
	)}
</section>
