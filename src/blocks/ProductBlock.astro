---
/** The "Product" block: a Shopify product with Add to cart and Buy now. */
import Product from "../components/Product.astro";

interface Props {
	/** `pick` is a product from the site's catalog; `handle` one typed in. */
	node: { pick?: string; handle?: string };
}

const handle = (Astro.props.node.pick || Astro.props.node.handle || "").trim();
---

{handle && <Product handle={handle} heading="h3" />}
